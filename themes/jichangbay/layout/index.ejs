                  <th style="padding: 6px 10px; border: 1px solid #ddd;">套餐名称</th>
                  <th style="padding: 6px 10px; border: 1px solid #ddd;">流量</th>
                  <th style="padding: 6px 10px; border: 1px solid #ddd;">月付</th>
                  <th style="padding: 6px 10px; border: 1px solid #ddd;">季付</th>
                  <th style="padding: 6px 10px; border: 1px solid #ddd;">半年付</th>
                  <th style="padding: 6px 10px; border: 1px solid #ddd;">年付</th>
                  <th style="padding: 6px 10px; border: 1px solid #ddd;">一次性/不限时</th>
                </tr>
              </thead>
              <tbody>
                <% p.plans.forEach(function(pl) { %>
                  <tr>
                    <td style="padding: 6px 10px; border: 1px solid #ddd;"><%= pl.name %></td>
                    <td style="padding: 6px 10px; border: 1px solid #ddd;"><%= pl.traffic %></td>
                    <td style="padding: 6px 10px; border: 1px solid #ddd;"><%= pl.monthly || '-' %></td>
                    <td style="padding: 6px 10px; border: 1px solid #ddd;"><%= pl.quarterly || '-' %></td>
                    <td style="padding: 6px 10px; border: 1px solid #ddd;"><%= pl.semiannual || '-' %></td>
                    <td style="padding: 6px 10px; border: 1px solid #ddd;"><%= pl.annual || '-' %></td>
                    <td style="padding: 6px 10px; border: 1px solid #ddd;"><%= pl.oneTime || '-' %></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
          <% } %>
          <div class="provider-action" style="margin-top: 15px; display: flex; gap: 10px; flex-wrap: wrap;">
            <a href="<%= p.affUrl || p.officialUrl %>" target="_blank" rel="nofollow noopener" class="btn btn-primary">查看套餐 / 注册购买</a>
            <% if (p.macDownload) { %>
              <a href="<%= p.macDownload %>" target="_blank" rel="nofollow noopener" class="btn mac-btn">Mac 客户端下载</a>
            <% } %>
          </div>
        </section>
      <% }) %>
    <% } %>

    <!-- How to Choose -->
