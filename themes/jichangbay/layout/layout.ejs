<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= config.title %></title>
  <meta name="description" content="<%= config.description %>">
  <meta name="keywords" content="<%= config.keywords %>">
  <% if (page.title === '404') { %>
  <meta name="robots" content="noindex, nofollow">
  <% } %>
  <link rel="canonical" href="<%= config.url %>/">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  
  <!-- Open Graph -->
  <meta property="og:type" content="website">
  <meta property="og:title" content="<%= config.title %>">
  <meta property="og:description" content="<%= config.description %>">
  <meta property="og:url" content="<%= config.url %>/">
  <meta property="og:site_name" content="机场湾 JichangBay">
  <meta property="og:locale" content="zh_CN">
  <meta property="og:image" content="<%= config.url %>/og-image.png">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:type" content="image/png">
  <meta property="og:image:alt" content="机场湾 JichangBay - 2026 机场推荐与 VPN 套餐选购指南">
  
  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= config.title %>">
  <meta name="twitter:description" content="<%= config.description %>">
  <meta name="twitter:image" content="<%= config.url %>/og-image.png">
  <meta name="twitter:image:alt" content="机场湾 JichangBay - 2026 机场推荐与 VPN 套餐选购指南">
  
  <!-- CSS -->
  <link rel="stylesheet" href="/css/style.css">
  
  <!-- Schema JSON-LD -->
  
</head>
<body>
  <%- body %>
  <!-- Scripts -->
  <script src="/js/main.js"></script>
</body>
</html>
